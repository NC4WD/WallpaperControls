[Desktop Entry]
Type=Application
Name=Set as Wallpaper
Comment=Preview this image as your wallpaper for light and dark mode
Exec=@EXEC@ --set-wallpaper %f
Icon=io.github.nc4wd.WallpaperControls
Terminal=false
NoDisplay=true
MimeType=image/jpeg;image/png;image/webp;image/bmp;image/gif;image/tiff;image/svg+xml;
